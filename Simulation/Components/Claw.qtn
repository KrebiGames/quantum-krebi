enum ClawSide {
	Left,
	Right
}

enum ClawState {
	Idle,
	Reach,
	Kick,
	Grab
}

component Claw {
	ClawSide Side;
	ClawState State;

	// Arm
	FPVector3 ShoulderLocalPosition;
	FPVector3 IdleLocalPosition;
	FPVector3 ReachLocalPosition;
	FP MaxReach;
	FP PositionSmooth;

	// Kick
	FP KickSmooth;
	FP KickDuration;
	FP KickTime;

	// Runtime
	FPVector3 PreviousDesiredPosition;
	FPVector3 CurrentLocalPosition;
}

component ClawGrab {
	// Settings
	FP GrabDetectRange;
	FP GrabReleaseRange;
	FP CollisionSafeDistance;
	FP GrabMaxAngle;
	FP GrabStrength;
	FP GrabDamping;
	FP MaxGrabForce;
	FP CrabReactionScale;
	FP GrabForceSmooth;
	FPVector3 CurrentGrabForce;

	// Runtime
	EntityRef Target;
	FPVector3 LocalPoint;
	FPVector3 PreviousHandlePosition;

	EntityRef CollisionTarget;
	FPVector3 CollisionLocalPoint;
	FPVector3 LastInteractionPosition;
	bool CollisionSuppressed;
}

component Interactable {
}

signal OnTargetGrabStarted(EntityRef target, EntityRef claw, FPVector3 position);
signal OnTargetGrabReleased(EntityRef target, EntityRef claw, FPVector3 position);

event ClawStateChanged {
	EntityRef Entity;
	ClawSide Side;
	ClawState State;
	FPVector3 TargetPosition;
}
