enum ClawSide {
	Left,
	Right
}

enum ClawState {
	Idle,
	Reach,
	Punch,
	Grab
}

component Claw {
	ClawSide Side;
	[ExcludeFromPrototype] ClawState State;

	FPVector3 ShoulderLocalPosition;
	FPVector3 IdleLocalPosition;
	FPVector3 ReachLocalPosition;
	FP MaxReach;
	FP PositionSmooth;

	[ExcludeFromPrototype] FPVector3 PreviousDesiredPosition;
	[ExcludeFromPrototype] FPVector3 CurrentLocalPosition;
}

component ClawTarget {
	FP DetectRange;

	[ExcludeFromPrototype] EntityRef Entity;
	[ExcludeFromPrototype] FPVector3 Point;
}

component ClawPunch {
	FP PunchStrength;
	FP PunchDuration;
	FP PunchSmooth;

	[ExcludeFromPrototype] FP PunchTime;
	[ExcludeFromPrototype] bool PunchApplied;
	[ExcludeFromPrototype] FPVector3 TargetLocalPosition;
}

component ClawGrab {
	FP GrabRange;
	FP CollisionSafeDistance;
	FP GrabMaxAngle;
	FP GrabResponsiveness;
	FP MaxGrabAcceleration;
	FP CrabReactionScale;

	[ExcludeFromPrototype] EntityRef Target;
	[ExcludeFromPrototype] FPVector3 LocalPoint;
	[ExcludeFromPrototype] FPVector3 TargetPosition;
	[ExcludeFromPrototype] FPVector3 PreviousHandlePosition;
	[ExcludeFromPrototype] FPVector3 CurrentGrabForce;
	[ExcludeFromPrototype] EntityRef CollisionTarget;
	[ExcludeFromPrototype] FPVector3 CollisionLocalPoint;
	[ExcludeFromPrototype] FPVector3 LastInteractionPosition;
	[ExcludeFromPrototype] bool CollisionSuppressed;
}

signal OnTargetGrabStarted(EntityRef target, EntityRef claw, FPVector3 position);
signal OnTargetGrabReleased(EntityRef target, EntityRef claw, FPVector3 position);

event ClawStateChanged {
	EntityRef Entity;
	ClawSide Side;
	ClawState State;
	FPVector3 TargetPosition;
}