enum PlayerTeam {
	Blue,
	Red
}

enum PlayerWaterState {
	None,
	Submerged,
	Surface,
	Seabed
}

component Player {
	FP WalkSpeed;
	FP SeaBedWalkSpeed;
	FP SwimSpeed;
	FP SwimJumpSpeed;
	FP SwimVerticalResponsiveness;
	FP WaterEntryResistance;
	FP SprintMultiplier;
	FP NormalJump;
	FP Mass;

	[ExcludeFromPrototype] PlayerRef PlayerRef;
}

component PlayerStatus {
	[ExcludeFromPrototype] player_ref PlayerRef;
	[ExcludeFromPrototype] entity_ref SpawnerEntityRef;
	[ExcludeFromPrototype] PlayerTeam PlayerTeam;

	asset_ref<PlayerMovementData> PlayerMovementData;

	[ExcludeFromPrototype] PlayerWaterState WaterState;
	[ExcludeFromPrototype] FP WaterSurfaceY;
	[ExcludeFromPrototype] bool WaterEntryActive;
}

component PlayerSpawner {
	player_ref PlayerRef;
	PlayerTeam PlayerTeam;
}

component BodyOrientation {
	FP OrientationAngle;
	FP NormalRotationSmooth;
	FP SprintRotationSmooth;
	FP InteractionRotationSmooth;

	[ExcludeFromPrototype] FP LocalYaw;
	[ExcludeFromPrototype] bool Interacting;
}

component BodyAnchor {
	[ExcludeFromPrototype] FP PreviousBaseYaw;
	[ExcludeFromPrototype] FP ContinuousBaseYaw;
	[ExcludeFromPrototype] bool Initialized;
}

signal OnPlayerRespawned(entity_ref playerEntityRef, bool fullReset);
signal OnPlayerRespawnTimerReset(entity_ref playerEntityRef);