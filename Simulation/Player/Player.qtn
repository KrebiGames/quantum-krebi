enum PlayerTeam {
	Blue, Red
}

component Player {
	FP WalkSpeed;
	FP NormalJump;

	[HideInInspector]
	PlayerRef PlayerRef;
}

component PlayerStatus {
	[ExcludeFromPrototype]
	player_ref PlayerRef;

	[ExcludeFromPrototype]
	entity_ref SpawnerEntityRef;

	[ExcludeFromPrototype]
	PlayerTeam PlayerTeam;

	asset_ref<PlayerMovementData> PlayerMovementData;
}

component PlayerSpawner {
	player_ref PlayerRef;
	PlayerTeam PlayerTeam;
}

component BodyOrientation {
	FP OrientationAngle;
	FP NormalRotationSmooth;
	FP SprintRotationSmooth;
	FP LocalYaw;
}

component BodyAnchor {
	FP PreviousBaseYaw;
	FP ContinuousBaseYaw;
	bool Initialized;
}

enum ClawSide {
	Left,
	Right
}

enum ClawState {
	Idle,
	Reach,
	Kick,
	Grab,
	Hold,
	Cut
}

component Claw {
	ClawSide Side;
	ClawState State;

	FPVector3 ShoulderLocalPosition;
	FP MaxReach;

	FPVector3 IdleLocalPosition;
	FPVector3 ReachLocalPosition;

	FP PositionSmooth;
	FP AttackSmooth;

	FP KickDuration;
	FP KickTime;

	FP GrabThreshold;
	FP GrabDelay;
	FP GrabTime;

	FPVector3 CurrentLocalPosition;
	bool Initialized;
}

component ClawTarget {
	EntityRef Entity;
	FPVector3 WorldPosition;
	FPQuaternion WorldRotation;
	bool HasWorldPose;
}

component ClawGrip {
	EntityRef Entity;
}

signal OnPlayerRespawned(entity_ref playerEntityRef, bool fullReset);
signal OnPlayerRespawnTimerReset(entity_ref playerEntityRef);
